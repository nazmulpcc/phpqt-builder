{
    "name": "nazmulpcc/phpqt-builder",
    "description": "Parse QT classes and build a PHP extension",
    "type": "project",
    "require": {
        "php": "^8.4",
        "ext-cparser": "*",
        "symfony/console": "^8.0",
        "symfony/process": "^8.0",
        "laravel/prompts": "^0.3.13",
        "symfony/dependency-injection": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "psy/psysh": "^0.12.20"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "QtBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QtBuilder\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Nazmul Alam",
            "email": "n@zmul.dev"
        }
    ],
    "minimum-stability": "stable"
}
